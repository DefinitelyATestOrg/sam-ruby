module Sam
  module Models
    type model_list_response =
      {
        data: ::Array[Sam::Models::ModelListResponse::Data],
        first_id: String?,
        has_more: bool,
        last_id: String?
      }

    class ModelListResponse < Sam::Internal::Type::BaseModel
      attr_accessor data: ::Array[Sam::Models::ModelListResponse::Data]

      attr_accessor first_id: String?

      attr_accessor has_more: bool

      attr_accessor last_id: String?

      def initialize: (
        data: ::Array[Sam::Models::ModelListResponse::Data],
        first_id: String?,
        has_more: bool,
        last_id: String?
      ) -> void

      def to_hash: -> {
        data: ::Array[Sam::Models::ModelListResponse::Data],
        first_id: String?,
        has_more: bool,
        last_id: String?
      }

      type data =
        { id: String, created_at: Time, display_name: String, type: :model }

      class Data < Sam::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor created_at: Time

        attr_accessor display_name: String

        attr_accessor type: :model

        def initialize: (
          id: String,
          created_at: Time,
          display_name: String,
          ?type: :model
        ) -> void

        def to_hash: -> {
          id: String,
          created_at: Time,
          display_name: String,
          type: :model
        }
      end
    end
  end
end
