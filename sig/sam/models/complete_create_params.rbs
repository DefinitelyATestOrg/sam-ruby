module Sam
  module Models
    type complete_create_params =
      {
        max_tokens_to_sample: Integer,
        model: String,
        prompt: String,
        metadata: Sam::Models::CompleteCreateParams::Metadata,
        stop_sequences: ::Array[String],
        stream: bool,
        temperature: Float,
        top_k: Integer,
        top_p: Float,
        anthropic_version: String,
        x_api_key: String
      }
      & Sam::request_parameters

    class CompleteCreateParams < Sam::BaseModel
      extend Sam::RequestParameters::Converter
      include Sam::RequestParameters

      attr_accessor max_tokens_to_sample: Integer

      attr_accessor model: String

      attr_accessor prompt: String

      attr_reader metadata: Sam::Models::CompleteCreateParams::Metadata?

      def metadata=: (
        Sam::Models::CompleteCreateParams::Metadata
      ) -> Sam::Models::CompleteCreateParams::Metadata

      attr_reader stop_sequences: ::Array[String]?

      def stop_sequences=: (::Array[String]) -> ::Array[String]

      attr_reader stream: bool?

      def stream=: (bool) -> bool

      attr_reader temperature: Float?

      def temperature=: (Float) -> Float

      attr_reader top_k: Integer?

      def top_k=: (Integer) -> Integer

      attr_reader top_p: Float?

      def top_p=: (Float) -> Float

      attr_reader anthropic_version: String?

      def anthropic_version=: (String) -> String

      attr_reader x_api_key: String?

      def x_api_key=: (String) -> String

      def initialize: (
        max_tokens_to_sample: Integer,
        model: String,
        prompt: String,
        ?metadata: Sam::Models::CompleteCreateParams::Metadata,
        ?stop_sequences: ::Array[String],
        ?stream: bool,
        ?temperature: Float,
        ?top_k: Integer,
        ?top_p: Float,
        ?anthropic_version: String,
        ?x_api_key: String,
        ?request_options: Sam::request_opts
      ) -> void

      def to_hash: -> Sam::Models::complete_create_params

      type metadata = { user_id: String? }

      class Metadata < Sam::BaseModel
        attr_accessor user_id: String?

        def initialize: (?user_id: String?) -> void

        def to_hash: -> Sam::Models::CompleteCreateParams::metadata
      end
    end
  end
end
