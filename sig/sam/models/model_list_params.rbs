module Sam
  module Models
    type model_list_params =
      {
        after_id: String,
        before_id: String,
        limit: Integer,
        anthropic_version: String,
        x_api_key: String
      }
      & Sam::Internal::Type::request_parameters

    class ModelListParams < Sam::Internal::Type::BaseModel
      extend Sam::Internal::Type::RequestParameters::Converter
      include Sam::Internal::Type::RequestParameters

      attr_reader after_id: String?

      def after_id=: (String) -> String

      attr_reader before_id: String?

      def before_id=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader anthropic_version: String?

      def anthropic_version=: (String) -> String

      attr_reader x_api_key: String?

      def x_api_key=: (String) -> String

      def initialize: (
        ?after_id: String,
        ?before_id: String,
        ?limit: Integer,
        ?anthropic_version: String,
        ?x_api_key: String,
        ?request_options: Sam::request_opts
      ) -> void

      def to_hash: -> Sam::Models::model_list_params
    end
  end
end
