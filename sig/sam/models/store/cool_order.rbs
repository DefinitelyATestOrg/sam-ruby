module Sam
  module Models
    module Store
      type cool_order =
        {
          id: Integer,
          complete: bool,
          pet_id: Integer,
          quantity: Integer,
          ship_date: Time,
          status: Sam::Models::Store::CoolOrder::status
        }

      class CoolOrder < Sam::BaseModel
        attr_reader id: Integer?

        def id=: (Integer) -> void

        attr_reader complete: bool?

        def complete=: (bool) -> void

        attr_reader pet_id: Integer?

        def pet_id=: (Integer) -> void

        attr_reader quantity: Integer?

        def quantity=: (Integer) -> void

        attr_reader ship_date: Time?

        def ship_date=: (Time) -> void

        attr_reader status: Sam::Models::Store::CoolOrder::status?

        def status=: (Sam::Models::Store::CoolOrder::status) -> void

        def initialize:
          (
            id: Integer,
            complete: bool,
            pet_id: Integer,
            quantity: Integer,
            ship_date: Time,
            status: Sam::Models::Store::CoolOrder::status
          ) -> void
          | (?Sam::Models::Store::cool_order | Sam::BaseModel data) -> void

        def to_hash: -> Sam::Models::Store::cool_order

        type status = :placed | :approved | :delivered

        class Status < Sam::Enum
          PLACED: :placed
          APPROVED: :approved
          DELIVERED: :delivered

          def self.values: -> ::Array[Sam::Models::Store::CoolOrder::status]
        end
      end
    end
  end
end
